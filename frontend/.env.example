# URL base da API backend (sem barra no final).
# Dev local: http://localhost:8080
# Produção: https://apineide.gsrodriguesz.me
NEXT_PUBLIC_API_URL=http://localhost:8080

# Mock local SOMENTE para desenvolvimento (dados fictícios).
# true = usa lib/mock-data.ts em vez da API real.
# Nunca tem efeito em produção (o código exige NODE_ENV !== "production").
# Para demo local: copie para .env.local com true (já ignorado pelo git).
NEXT_PUBLIC_USE_MOCK=false
